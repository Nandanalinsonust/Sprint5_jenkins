@using Microsoft.AspNetCore.Components.Routing

<!-- Hamburger button always visible -->
<button type="button"
        class="ha-sidebar-menu-button"
        @onclick="ToggleSidebar"
        title="Open Menu">
    ☰
</button>

@if (isSidebarOpen)
{
    <div class="ha-sidebar-click-overlay"
         @onclick="CloseSidebar">
        <AdminSidebar />
    </div>
}

<aside class="@SidebarClass">


    <nav class="ha-sidebar-nav">
        <NavLink href="admin/dashboard"
                 class="ha-sidebar-link"
                 Match="NavLinkMatch.All">
            <span class="ha-sidebar-label">Dashboard</span>
        </NavLink>

        <NavLink href="admin/doctors"
                 class="ha-sidebar-link">
            <span class="ha-sidebar-label">Doctors</span>
        </NavLink>

        <NavLink href="admin/patients"
                 class="ha-sidebar-link">
            <span class="ha-sidebar-label">Patients</span>
        </NavLink>

        <NavLink href="admin/appointments"
                 class="ha-sidebar-link">
            <span class="ha-sidebar-label">Appointments</span>
        </NavLink>
    </nav>

   
</aside>

@code {
    private bool isSidebarOpen = false;

    private string SidebarClass =>
        isSidebarOpen
            ? "ha-popout-sidebar ha-popout-sidebar-open"
            : "ha-popout-sidebar";

    private void ToggleSidebar()
    {
        isSidebarOpen = !isSidebarOpen;
    }

    private void CloseSidebar()
    {
        isSidebarOpen = false;
    }
}