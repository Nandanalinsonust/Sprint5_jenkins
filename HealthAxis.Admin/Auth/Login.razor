@page "/"
@attribute [AllowAnonymous]
@inject AuthService AuthService 
@layout LoginLayout

@inject NavigationManager Nav

<div class="login-wrapper">

    <div class="login-card row g-0">

        <div class="col-md-6 left-panel">
            <div class="image-container">
                <img src="images\Admin.png" alt="login illustration" />
            </div>
        </div>

        <div class="col-md-6 right-panel">

            <div class="login-box">

                <h3 class="login-title">Login as Admin</h3>

                <EditForm Model="loginDto" OnValidSubmit="HandleLogin">

                    <InputText class="form-control custom-input mb-3"
                               @bind-Value="loginDto.Email"
                               placeholder="Enter email" />

                    <InputText type="password"
                               class="form-control custom-input mb-3"
                               @bind-Value="loginDto.Password"
                               placeholder="Enter password" />

                    @if (!string.IsNullOrEmpty(error))
                    {
                        <div class="alert alert-danger text-center py-2">
                            @error
                        </div>
                    }

                    <button class="btn login-btn w-100 mt-2">
                        LOGIN
                    </button>

                </EditForm>

            </div>
        </div>

    </div>
</div>

@code {
    private LoginDto loginDto = new();
    private string error;

    private async Task HandleLogin()
    {
        error = "";

        var result = await AuthService.LoginAsync(loginDto);

        if (result.Success)
        {
            Nav.NavigateTo("/dashboard");
        }
        else
        {
            error = result.Message;
        }
    }
}