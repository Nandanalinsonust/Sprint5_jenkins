@page "/admin-login-bridge"

@inject NavigationManager Navigation
@inject IJSRuntime JS

<div style="min-height:100vh; display:grid; place-items:center; font-family:Arial;">
    <div style="text-align:center;">
        <h3>Signing you in...</h3>
        <p>Please wait while HealthAxis opens your admin portal.</p>
    </div>
</div>

@code {
    private const string TokenStorageKey = "token";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            Console.WriteLine("STEP 1");

            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);

            var token = GetQueryValue(uri.Query, "token");

            Console.WriteLine("STEP 2");

            if (string.IsNullOrWhiteSpace(token))
            {
                Console.WriteLine("NO TOKEN");
                return;
            }

            Console.WriteLine("STEP 3");

            await JS.InvokeVoidAsync(
                "localStorage.setItem",
                TokenStorageKey,
                token);

            Console.WriteLine("STEP 4");

            Navigation.NavigateTo("/admin/dashboard", true);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.ToString());
        }
    }

    private static string GetQueryValue(string queryString, string key)
    {
        if (string.IsNullOrWhiteSpace(queryString))
        {
            return string.Empty;
        }

        var query = queryString.TrimStart('?');

        var pairs = query.Split('&', StringSplitOptions.RemoveEmptyEntries);

        foreach (var pair in pairs)
        {
            var parts = pair.Split('=', 2);

            if (parts.Length != 2)
            {
                continue;
            }

            if (parts[0] == key)
            {
                return Uri.UnescapeDataString(parts[1]);
            }
        }

        return string.Empty;
    }
}