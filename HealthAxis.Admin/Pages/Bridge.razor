@page "/bridge"
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="bridge-page">
    <div class="bridge-message">
        <h3>Signing in as Admin…</h3>
        <p>Please wait while we redirect you to the admin dashboard.</p>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("accessToken", out var token) && !string.IsNullOrWhiteSpace(token))
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "accessToken", token.ToString());
            Nav.NavigateTo("/dashboard", true);
        }
        else
        {
            Nav.NavigateTo("/login");
        }
    }
}
