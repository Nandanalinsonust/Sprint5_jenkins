@page "/doctors"
@inject IAdminService AdminService

<h2 class="mb-4">Doctor Management</h2>

<!-- ✅ STATS -->
<div class="row mb-4">

    <div class="col-md-4">
        <div class="stat-card">
            <p>Total Doctors</p>
            <h3>@total</h3>
        </div>
    </div>

    <div class="col-md-4">
        <div class="stat-card">
            <p>Active</p>
            <h3>@active</h3>
        </div>
    </div>

    <div class="col-md-4">
        <div class="stat-card">
            <p>Inactive</p>
            <h3>@inactive</h3>
        </div>
    </div>

</div>

<div class="filter-box mb-4">

    <!-- SEARCH -->
    <input class="form-control"
           placeholder="Search name..."
           @bind="searchText"
           @bind:event="oninput" />

    <!-- SPECIALISATION -->
    <select class="form-control"
            @bind="selectedSpecialisation">
        <option value="">All Specialisations</option>
        <option>Cardiology</option>
        <option>Dermatology</option>
        <option>Pediatrics</option>
    </select>

    <!-- STATUS -->
    <select class="form-control"
            @bind="selectedStatus">
        <option value="">All</option>
        <option value="active">Active</option>
        <option value="inactive">Inactive</option>
    </select>

    <!-- PAGE SIZE -->
    <select class="form-control w-auto"
            @bind="pageSize"
            @bind:after="ReloadFromStart">
        <option value="5">5</option>
        <option value="10">10</option>
        <option value="15">15</option>
        <option value="20">20</option>
    </select>

    <button class="btn btn-secondary" @onclick="ApplyFilter">
        Apply
    </button>

    <button class="btn btn-outline-light" @onclick="ClearFilters">
        Clear
    </button>

</div>

<!-- ✅ TABLE -->
<div class="table-container">

    <table class="table table-dark">

        <thead>
            <tr>
                <th>Doctor</th>
                <th>Specialisation</th>
                <th>Experience</th>
                <th>Status</th>
                <th>Active</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var d in filteredDoctors)
            {
                <tr>
                    <td>
                        <b>@d.FullName</b><br />
                        <small>ID: @d.DoctorId</small>
                    </td>

                    <td>@d.Specialisation</td>
                    <td>@d.YearsOfExperience yrs</td>

                    <td>
                        @if (d.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactive</span>
                        }
                    </td>

                    <td>
                        <label class="switch">
                            <input type="checkbox"
                                   checked="@d.IsActive"
                                   @onchange="() => Toggle(d)" />
                            <span class="slider"></span>
                        </label>
                    </td>

                    <td>
                        <button class="btn btn-sm btn-outline-light">👁</button>
                    </td>
                </tr>
            }
        </tbody>

    </table>
</div>

<!-- ✅ PAGINATION -->
<div class="pagination-box mt-3">

    <button class="btn btn-secondary"
            @onclick="Prev"
            disabled="@(currentPage == 1)">
        ⬅ Prev
    </button>

    <span class="page-text">Page @currentPage</span>

    <button class="btn btn-secondary"
            @onclick="Next"
            disabled="@(hasNext == false)">
        Next ➡
    </button>

</div>

@code {

    private int currentPage = 1;
    private int pageSize = 15;
    private bool hasNext = true;

    private List<DoctorDto> doctors = [];
    private List<DoctorDto> filteredDoctors = [];

    private int total, active, inactive;

    private string searchText = "";
    private string selectedSpecialisation = "";
    private string selectedStatus = "";

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        doctors = await AdminService.GetDoctors(currentPage, pageSize);
        hasNext = doctors.Count == pageSize;

        ApplyFilter();
    }

    private void ApplyFilter()
    {
        filteredDoctors = doctors
            .Where(d =>
                (string.IsNullOrEmpty(searchText) || d.FullName.Contains(searchText, StringComparison.OrdinalIgnoreCase)) &&
                (string.IsNullOrEmpty(selectedSpecialisation) || d.Specialisation == selectedSpecialisation) &&
                (string.IsNullOrEmpty(selectedStatus) ||
                 (selectedStatus == "active" && d.IsActive) ||
                 (selectedStatus == "inactive" && !d.IsActive))
            ).ToList();

        total = filteredDoctors.Count;
        active = filteredDoctors.Count(d => d.IsActive);
        inactive = total - active;
    }

    private void ClearFilters()
    {
        searchText = "";
        selectedSpecialisation = "";
        selectedStatus = "";
        ApplyFilter();
    }

    private async Task Toggle(DoctorDto d)
    {
        if (d.IsActive)
        {
            await AdminService.DeactivateDoctor(d.DoctorId);
            d.IsActive = false;
        }

        ApplyFilter();
    }

    private async Task Next()
    {
        currentPage++;
        await Load();
    }

    private async Task Prev()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await Load();
        }
    }

    private async Task ReloadFromStart()
    {
        currentPage = 1;
        await Load();
    }
}