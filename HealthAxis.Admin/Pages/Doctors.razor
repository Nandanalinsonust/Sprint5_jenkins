@page "/doctors"
@attribute [Authorize]
@layout AdminLayout

@using HealthAxis.Shared.Enums
@using HealthAxis.Shared.Dtos

@inject IDoctorService DoctorService
@inject IAuthService AuthService
@inject NavigationManager Nav

<h3 class="mb-4">Doctor Management</h3>

@if (isLoading)
{
    <LoadingSpinner Visible="true" />
}
else
{
    <!-- ✅ STATS -->
    <div class="row mb-4">
        <div class="col-md-4"><div class="stat-card"><p>Total Doctors</p><h3>@totalDoctors</h3></div></div>
        <div class="col-md-4"><div class="stat-card"><p>Active</p><h3>@activeDoctors</h3></div></div>
        <div class="col-md-4"><div class="stat-card"><p>Inactive</p><h3>@inactiveDoctors</h3></div></div>
    </div>

    <!-- ✅ FILTER -->
    <div class="filter-bar">
        <input class="filter-input" placeholder="Search name / ID" @bind="searchTerm" @oninput="OnSearchChanged"/>

        <select class="filter-input" @bind="selectedSpec">
            <option value="">Select Specialisation</option>
            @foreach (var s in Enum.GetValues<DoctorSpecialisation>())
            {
                <option value="@s">@s</option>
            }
        </select>

        <select class="filter-input" @bind="selectedStatus">
            <option value="">All</option>
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
        </select>

        <button class="btn-clear" @onclick="ClearFilters">Clear</button>

        <button class="btn-add" @onclick="OpenAddModal">
            + Add Doctor
        </button>
    </div>

    <!-- ✅ TABLE -->
    <div class="table-container">
        <table class="table table-dark">
            <thead>
                <tr>
                    <th>Doctor</th>
                    <th>Specialisation</th>
                    <th>Experience</th>
                    <th>Status</th>
                    <th>Active</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @if (!filteredDoctors.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-white py-3">
                            No doctors found
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var doc in filteredDoctors)
                    {
                        <tr>
                            <td>
                                <b>@doc.FullName</b><br />
                                <small>ID: @doc.DoctorId</small>
                            </td>

                            <td>@doc.Specialisation</td>
                            <td>@doc.YearsOfExperience yrs</td>

                            <td>
                                <span class="badge @(doc.IsActive ? "bg-success" : "bg-danger")">
                                    @(doc.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>

                            <td>
                                <div class="toggle-switch" @onclick="() => ToggleActive(doc)">
                                    <div class="toggle-circle @(doc.IsActive ? "active" : "")"></div>
                                </div>
                            </td>

                            <td>
                                <button class="eye-btn" @onclick="() => OpenViewModal(doc)">👁</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

<!-- ✅ VIEW MODAL -->
@if (showViewModal)
{
    <div class="modal-bg">
        <div class="modal-box">

            <div class="modal-header">
                <h5>Doctor Details</h5>

                <div>
                    <!-- ✅ EDIT BUTTON -->
                    @if (!isEditing)
                    {
                        <button class="icon-btn" @onclick="EnableEdit">
                            ✏ Edit
                        </button>
                    }

                    <!-- ✅ CLOSE -->
                    <button class="icon-btn" @onclick="CloseViewModal">
                        ✖
                    </button>
                </div>
            </div>

            <div class="modal-body">

                @if (!isEditing)
                {
                    <!-- ✅ VIEW MODE -->
                    <p><b>Name:</b> @selectedDoctor.FullName</p>
                    <p><b>Specialisation:</b> @selectedDoctor.Specialisation</p>
                    <p><b>Experience:</b> @selectedDoctor.YearsOfExperience</p>
                    <p><b>Fee:</b> ₹@selectedDoctor.ConsultationFee</p>
                }
                else
                {
                    <!-- ✅ EDIT MODE -->
                    <div class="form-row">
                        <label>Name</label>
                        <input @bind="editDoctor.FullName" />
                    </div>

                    <div class="form-row">
                        <label>Specialisation</label>
                        <select @bind="editDoctor.Specialisation">
                            @foreach (var s in Enum.GetValues<DoctorSpecialisation>())
                            {
                                <option value="@s">@s</option>
                            }
                        </select>
                    </div>

                    <div class="form-row">
                        <label>Experience</label>
                        <input @bind="editDoctor.YearsOfExperience" />
                    </div>

                    <div class="form-row">
                        <label>Fee</label>
                        <input @bind="editDoctor.ConsultationFee" />
                    </div>
                }
            </div>

            <!-- ✅ SAVE BUTTON (only in edit mode) -->
            @if (isEditing)
            {
                <div class="modal-footer">
                    <button class="btn btn-success" @onclick="SaveEdit">
                        Save
                    </button>
                </div>
            }

        </div>
    </div>
}

<!-- ✅ ADD MODAL -->
@if (showAddModal)
{
    <div class="modal-bg">
        <div class="modal-box">

            <div class="modal-header">
                <h5>Add Doctor</h5>

                <!-- ✅ FIXED CLOSE -->
                <button class="icon-btn" @onclick="CloseAddModal">✖</button>
            </div>

            <div class="modal-body">

                <div class="form-row">
                    <label>Name</label>
                    <input @bind="newDoctor.FullName" placeholder="Enter name" />
                </div>

                <div class="form-row">
                    <label>Email</label>
                    <input @bind="newDoctor.Email" placeholder="Enter email" />
                </div>

                <div class="form-row">
                    <label>Specialisation</label>
                    <select @bind="selectedSpecInput">
                        <option value="">Select Specialisation</option>
                        @foreach (var s in Enum.GetValues<DoctorSpecialisation>())
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </div>

                <div class="form-row">
                    <label>Experience</label>
                    <input placeholder="Enter experience" @bind="experienceInput" />
                </div>

                <div class="form-row">
                    <label>Fee</label>
                    <input placeholder="Enter fee" @bind="feeInput" />
                </div>

            </div>

            <div class="modal-footer">
                <button class="btn btn-primary" @onclick="AddDoctor">Add</button>
            </div>

        </div>
    </div>
}

@code {
    private List<DoctorDto> doctors = new();

    private int totalDoctors;
    private int activeDoctors;
    private int inactiveDoctors;

    private bool isLoading = true;

    private string searchTerm;
    private string selectedStatus;
    private DoctorSpecialisation? selectedSpec;

    private bool showViewModal;
    private bool showAddModal;
    private bool isEditing = false;

    private DoctorDto selectedDoctor = new();
    private UpdateDoctorDto editDoctor = new();   // ✅ FIXED
    private CreateDoctorDto newDoctor = new();

    private string experienceInput = "";
    private string feeInput = "";
    private DoctorSpecialisation? selectedSpecInput;

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthService.IsAuthenticatedAsync())
        {
            Nav.NavigateTo("/login", true);
            return;
        }

        await LoadDoctors();
    }

    private async Task LoadDoctors()
    {
        doctors = await DoctorService.GetAllAsync();

        totalDoctors = doctors.Count;
        activeDoctors = doctors.Count(x => x.IsActive);
        inactiveDoctors = doctors.Count(x => !x.IsActive);

        isLoading = false;
    }

    private IEnumerable<DoctorDto> filteredDoctors =>
    doctors.Where(d =>
        string.IsNullOrWhiteSpace(searchTerm) ||

        d.FullName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
        d.DoctorId.ToString().Contains(searchTerm)
    )
    .Where(d =>
        !selectedSpec.HasValue || d.Specialisation == selectedSpec
    )
    .Where(d =>
        string.IsNullOrEmpty(selectedStatus) ||
        (selectedStatus == "active" && d.IsActive) ||
        (selectedStatus == "inactive" && !d.IsActive)
    );

    private void ClearFilters()
    {
        searchTerm = "";
        selectedSpec = null;
        selectedStatus = "";
    }

    // ✅ FIXED VIEW OPEN
    private void OpenViewModal(DoctorDto doc)
    {
        selectedDoctor = doc;

        editDoctor = new UpdateDoctorDto
        {
            DoctorId = doc.DoctorId,
            FullName = doc.FullName,
            Specialisation = doc.Specialisation,
            YearsOfExperience = doc.YearsOfExperience,
            ConsultationFee = doc.ConsultationFee,
            IsActive = doc.IsActive
        };

        showViewModal = true;
        isEditing = false;
    }

    // ✅ KEEP ONLY THIS (REMOVE OLD ONE)
    private void CloseViewModal()
    {
        showViewModal = false;
        isEditing = false;
    }

    private void EnableEdit()
    {
        isEditing = true;
    }

    private async Task SaveEdit()
    {
        await DoctorService.UpdateAsync(editDoctor.DoctorId, editDoctor);

        await LoadDoctors();

        showViewModal = false;
        isEditing = false;
    }

    private void OpenAddModal()
    {
        newDoctor = new CreateDoctorDto();
        experienceInput = "";
        feeInput = "";
        selectedSpecInput = null;

        showAddModal = true;
    }

    private void CloseAddModal()
    {
        showAddModal = false;
    }

    private async Task AddDoctor()
    {
        newDoctor.Specialisation =
            selectedSpecInput ?? DoctorSpecialisation.GeneralPractitioner;

        newDoctor.YearsOfExperience =
            int.TryParse(experienceInput, out var exp) ? exp : 0;

        newDoctor.ConsultationFee =
            int.TryParse(feeInput, out var fee) ? fee : 0;

        await DoctorService.AddAsync(newDoctor);

        await LoadDoctors();

        showAddModal = false;
    }

    private async Task ToggleActive(DoctorDto doc)
    {
        doc.IsActive = !doc.IsActive;
        StateHasChanged();
        await DoctorService.DeactivateAsync(doc.DoctorId);
    }
    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";

        StateHasChanged();
    }
}