@page "/dashboard"
@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout

@inject IAdminService AdminService
@inject IAuthService AuthService
@inject NavigationManager Nav
@inject IJSRuntime JS

<h3 class="mb-3">Dashboard</h3>

<!-- ✅ DAY / WEEK TOGGLE -->
<div class="mb-3">
    <button class="btn btn-sm btn-primary me-2"
            @onclick='() => ChangeRange("day")'>
        Today
    </button>

    <button class="btn btn-sm btn-outline-light"
            @onclick='() => ChangeRange("week")'>
        This Week
    </button>
</div>

<!-- ✅ COUNTS -->
<div class="row mb-4">

    <div class="col-md-4">
        <div class="stat-card">
            <p>Total Doctors</p>
            <h3>@totalDoctors</h3>
        </div>
    </div>

    <div class="col-md-4">
        <div class="stat-card">
            <p>Total Patients</p>
            <h3>@totalPatients</h3>
        </div>
    </div>

    <div class="col-md-4">
        <div class="stat-card">
            <p>Total Appointments (@selectedRange)</p>
            <h3>@totalAppointments</h3>
        </div>
    </div>

</div>

<!-- ✅ CHART AREA -->
<div class="row">

    <!-- BAR CHART -->
    <div class="col-md-6">
        <h5>Appointments by Department</h5>
        <canvas id="barChart"></canvas>
    </div>

    <!-- DROPDOWN + PIE -->
    <div class="col-md-6">
        <h5>Doctors inside Department</h5>

        <select class="form-control mb-2" @onchange="OnDepartmentChange">
            <option value="">-- Select Department --</option>
            @foreach (var dept in departmentLabels)
            {
                <option value="@dept">@dept</option>
            }
        </select>

        <canvas id="pieChart"></canvas>
    </div>

</div>

@code {
    private string selectedRange = "day";

    private int totalDoctors;
    private int totalPatients;
    private int totalAppointments;

    private List<string> departmentLabels = new();
    private List<int> departmentCounts = new();

    private List<string> doctorLabels = new();
    private List<int> doctorCounts = new();

    private bool chartRendered = false;

    protected override async Task OnInitializedAsync()
    {
        var isAuthenticated = await AuthService.IsAuthenticatedAsync();

        if (!isAuthenticated)
        {
            Nav.NavigateTo("/login", true);
            return;
        }

        await LoadDashboard();
    }

    // ✅ TOGGLE RANGE
    private async Task ChangeRange(string range)
    {
        selectedRange = range;
        chartRendered = false;
        await LoadDashboard();
    }

    // ✅ LOAD DATA
    private async Task LoadDashboard()
    {
        var counts = await AdminService.GetCountsAsync(selectedRange);

        if (counts != null)
        {
            totalDoctors = counts.TotalDoctors;
            totalPatients = counts.TotalPatients;
            totalAppointments = counts.TotalAppointments;
        }

        var departmentData = await AdminService.GetDepartmentStatsAsync(selectedRange);

        departmentLabels = departmentData?.Select(x => x.Department).ToList() ?? new();
        departmentCounts = departmentData?.Select(x => x.Count).ToList() ?? new();

        StateHasChanged();
    }

    // ✅ DEPARTMENT CHANGE -> PIE CHART
    private async Task OnDepartmentChange(ChangeEventArgs e)
    {
        var dept = e.Value?.ToString();

        if (string.IsNullOrEmpty(dept)) return;

        var data = await AdminService.GetDoctorByDepartment(dept);

        // doctorLabels = data.Select(x => x.FullName).ToList();
        doctorCounts = data.Select(x => x.Count).ToList();

        await JS.InvokeVoidAsync("renderPieChart", doctorLabels, doctorCounts);
    }

    // ✅ RENDER CHARTS
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!chartRendered && departmentLabels.Count > 0)
        {
            chartRendered = true;

            await JS.InvokeVoidAsync(
                "renderDepartmentBarChart",
                departmentLabels,
                departmentCounts
            );
        }
    }
}