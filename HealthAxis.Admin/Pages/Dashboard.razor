@page "/dashboard"
@inject IAdminService AdminService
@inject IJSRuntime JS

<h2 class="mb-4 page-title">Dashboard</h2>

<!-- ✅ STATS -->
<div class="row mb-4">

    <div class="col-md-3">
        <div class="dash-card">
            <p>Total</p>
            <h2>@total</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="dash-card success">
            <p>Confirmed</p>
            <h2>@confirmed</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="dash-card warning">
            <p>Completed</p>
            <h2>@completed</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="dash-card danger">
            <p>Cancelled</p>
            <h2>@cancelled</h2>
        </div>
    </div>

</div>

<!-- ✅ CHART -->
<div class="panel mb-4">
    <h5>Appointments Overview</h5>
    <canvas id="chart"></canvas>
</div>

<!-- ✅ TABLE -->
<div class="panel">
    <h5>Appointment Summary</h5>

    <table class="table table-dark custom-table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Confirmed</th>
                <th>Cancelled</th>
                <th>Completed</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in data)
            {
                <tr>
                    <td>@item.Date.ToShortDateString()</td>
                    <td>@item.Confirmed</td>
                    <td>@item.Cancelled</td>
                    <td>@item.Completed</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private List<AppointmentSummaryDto> data = [];

    private int total;
    private int confirmed;
    private int completed;
    private int cancelled;

    protected override async Task OnInitializedAsync()
    {
        data = await AdminService.GetAppointmentSummary();

        confirmed = data.Sum(x => x.Confirmed);
        completed = data.Sum(x => x.Completed);
        cancelled = data.Sum(x => x.Cancelled);

        total = confirmed + completed + cancelled;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("renderChart",
                confirmed, completed, cancelled);
        }
    }
}
