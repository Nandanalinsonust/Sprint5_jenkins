@page "/dashboard"
@attribute [Authorize]
@layout MainLayout


@inject HttpClient Http
@inject IJSRuntime JS

<h3 class="mb-4">Dashboard</h3>

<LoadingSpinner IsVisible="isLoading" />

@if (!isLoading)
{
    <!-- ✅ COUNTS -->
    <div class="row mb-4">

        <div class="col-md-4">
            <div class="stat-card">
                <p>Total Doctors</p>
                <h3>@totalDoctors</h3>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-card">
                <p>Total Patients</p>
                <h3>@totalPatients</h3>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-card">
                <p>Total Appointments</p>
                <h3>@totalAppointments</h3>
            </div>
        </div>

    </div>

    <!-- ✅ CHARTS + CALENDAR -->
    <div class="row">

        <!-- BAR CHART -->
        <div class="col-md-6">
            <div class="table-container">
                <h5>Today's Appointments (Doctors)</h5>
                <canvas id="barChart"></canvas>
            </div>
        </div>

        <!-- CALENDAR -->
        <div class="col-md-3">
            <div class="table-container">
                <h5>Select Date</h5>
                <input type="date" class="form-control" />
            </div>
        </div>

        <!-- PIE CHART -->
        <div class="col-md-3">
            <div class="table-container">
                <h5>Department Load</h5>
                <canvas id="pieChart"></canvas>
            </div>
        </div>

    </div>
}
@code {
    private bool isLoading = true;
    private bool chartRendered = false;

    private int totalDoctors;
    private int totalPatients;
    private int totalAppointments;

    private List<string> doctorLabels = new();
    private List<int> doctorCounts = new();

    private List<string> departmentLabels = new();
    private List<int> departmentCounts = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCounts();
        await LoadDoctorChart();
        await LoadDepartmentChart();

        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!isLoading && !chartRendered)
        {
            chartRendered = true;
            try
            {
                await JS.InvokeVoidAsync("renderBarChart", doctorLabels, doctorCounts);
                await JS.InvokeVoidAsync("renderPieChart", departmentLabels, departmentCounts);
            }
            catch
            {
                Console.WriteLine("Error");
            }
        }
    
        }

    private async Task LoadCounts()
    {
        var result = await Http.GetFromJsonAsync<DashboardCountDto>(
            "api/admin/dashboard/counts");

        totalDoctors = result.totalDoctors;
        totalPatients = result.totalPatients;
        totalAppointments = result.totalAppointments;
    }

    private async Task LoadDoctorChart()
    {
        var data = await Http.GetFromJsonAsync<List<DoctorChartDto>>(
            "api/admin/dashboard/today-doctor");

        
        doctorLabels = data?.Select(x => $"Dr {x.DoctorId}").ToList() ?? new();
        doctorCounts = data?.Select(x => x.Count).ToList() ?? new();

    }

    private async Task LoadDepartmentChart()
    {
        var data = await Http.GetFromJsonAsync<List<DepartmentChartDto>>(
            "api/admin/dashboard/departments");

        
        departmentLabels = data?.Select(x => x.Department).ToList() ?? new();
        departmentCounts = data?.Select(x => x.Count).ToList() ?? new();

    }
}
