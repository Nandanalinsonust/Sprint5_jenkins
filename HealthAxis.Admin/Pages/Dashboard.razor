@page "/dashboard"
@attribute [Authorize]
@layout MainLayout

@using HealthAxis.Shared.Dtos
@using HealthAxis.Admin.Services.Interfaces

@inject IAuthService AuthService
@inject IAdminService AdminService
@inject NavigationManager Navigation

<PageTitle>Admin Dashboard | HealthAxis</PageTitle>

@if (isLoading)
{
    <div class="hc-page-loading">
        <div class="hc-loading-card">
            <p>Loading dashboard...</p>
        </div>
    </div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}
else
{
    <!-- ✅ Stats -->
    <div class="row mb-4">

        <div class="col-md-4">
            <div class="stat-card">
                <p>Total Doctors</p>
                <h3>@totalDoctors</h3>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-card">
                <p>Total Patients</p>
                <h3>@totalPatients</h3>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-card">
                <p>Total Appointments</p>
                <h3>@totalAppointments</h3>
            </div>
        </div>

    </div>

    <!-- ✅ Quick Actions -->
    <div class="row">

        <div class="col-md-4">
            <button class="btn btn-outline-primary w-100" @onclick="GoToDoctors">
                Manage Doctors
            </button>
        </div>

        <div class="col-md-4">
            <button class="btn btn-outline-success w-100" @onclick="GoToPatients">
                Manage Patients
            </button>
        </div>

        <div class="col-md-4">
            <button class="btn btn-outline-warning w-100" @onclick="GoToAppointments">
                Manage Appointments
            </button>
        </div>

    </div>
}

@code {
    private bool isLoading = true;
    private string? errorMessage;

    private int totalDoctors;
    private int totalPatients;
    private int totalAppointments;

    protected override async Task OnInitializedAsync()
    {
        // ✅ AUTH CHECK (correct)
        var isAuthenticated = await AuthService.IsAuthenticatedAsync();

        if (!isAuthenticated)
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        await LoadDashboard();
    }

    private async Task LoadDashboard()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            // ✅ API CALLS (your service)
            var counts = await AdminService.GetCountsAsync();

            if (counts != null)
            {
                totalDoctors = counts.TotalDoctors;
                totalPatients = counts.TotalPatients;
                totalAppointments = counts.TotalAppointments;
            }
        }
        catch (UnauthorizedAccessException)
        {
            // ✅ if token expired
            Navigation.NavigateTo("/login?sessionExpired=true", true);
        }
        catch (HttpRequestException)
        {
            errorMessage = "API not reachable.";
        }
        catch (Exception ex)
        {
            errorMessage = "Unexpected error occurred.";
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoToDoctors()
    {
        Navigation.NavigateTo("/doctors");
    }

    private void GoToPatients()
    {
        Navigation.NavigateTo("/patients");
    }

    private void GoToAppointments()
    {
        Navigation.NavigateTo("/appointments");
    }
}