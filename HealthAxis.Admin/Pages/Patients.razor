@page "/patients"
@inject IAdminService AdminService

<h2 class="mb-4">Patient Management</h2>

<!-- ✅ STATS -->
<div class="row mb-4">

    <div class="col-md-4">
        <div class="stat-card">
            <p>Total Patients</p>
            <h3>@total</h3>
        </div>
    </div>

    <div class="col-md-4">
        <div class="stat-card">
            <p>Active</p>
            <h3>@active</h3>
        </div>
    </div>

    <div class="col-md-4">
        <div class="stat-card">
            <p>Insured</p>
            <h3>@insured</h3>
        </div>
    </div>

</div>

<!-- ✅ FILTER -->
<div class="filter-box mb-4">

    <select class="form-control" @bind="sortBy">
        <option value="">Sort by Name</option>
        <option value="name">Name</option>
    </select>

    <select class="form-control" @bind="filterType">
        <option value="">All</option>
        <option value="insured">Insured</option>
        <option value="not">Not Insured</option>
    </select>

</div>

<!-- ✅ TABLE -->
<div class="table-container">

    <table class="table table-dark">

        <thead>
            <tr>
                <th>Patient</th>
                <th>Age</th>
                <th>Gender</th>
                <th>Phone</th>
                <th>Insurance</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var p in filteredPatients)
            {
                <tr>
                    <td>
                        <b>@p.FullName</b><br />
                        <small>ID: @p.PatientId</small>
                    </td>

                    <td>@GetAge(p.DateOfBirth)</td>

                    <td>@p.Gender</td>

                    <td>@p.PhoneNumber</td>

                    <td>
                        @if (!string.IsNullOrEmpty(p.InsuranceID))
                        {
                            <span class="badge badge-insured">Insured</span>
                        }
                        else
                        {
                            <span>Not Insured</span>
                        }
                    </td>

                    <td>
                        <label class="switch">
                            <input type="checkbox"
                                   checked="@p.IsActive"
                                   @onchange="() => TogglePatient(p)" />
                            <span class="slider"></span>
                        </label>
                    </td>


                    <td>
                        <button class="btn btn-sm btn-outline-light">
                            👁
                        </button>
                    </td>
                </tr>
            }
        </tbody>

    </table>
</div>

@code {

    private List<PatientDto> patients = [];
    private List<PatientDto> filteredPatients = [];

    private int total, active, insured;

    private string sortBy = "";
    private string filterType = "";

    protected override async Task OnInitializedAsync()
    {
        patients = await AdminService.GetPatients(1, 20);

        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var query = patients.AsQueryable();

        if (filterType == "insured")
            query = query.Where(p => !string.IsNullOrEmpty(p.InsuranceID));

        if (filterType == "not")
            query = query.Where(p => string.IsNullOrEmpty(p.InsuranceID));

        if (sortBy == "name")
            query = query.OrderBy(p => p.FullName);

        filteredPatients = query.ToList();

        total = patients.Count;
        active = patients.Count(p => p.IsActive);
        insured = patients.Count(p => !string.IsNullOrEmpty(p.InsuranceID));
    }

    private int GetAge(DateTime dob)
    {
        return DateTime.Now.Year - dob.Year;
    }
    private async Task TogglePatient(PatientDto p)
    {
        await AdminService.DeactivatePatient(p.PatientId);

        p.IsActive = !p.IsActive;

        ApplyFilter();
    }
}