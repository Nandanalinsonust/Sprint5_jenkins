@page "/users"
@inject HttpClient Http
@namespace HealthAxis.Admin.Pages


<h3>Users</h3>
<LoadingSpinner IsVisible="isLoading" Message="Loading users..." />
<table class="table table-dark">
    <thead>
        <tr>
            <th>Email</th>
            <th>Role</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var u in users)
        {
            <tr>
                <td>@u.Email</td>
                <td>@u.Role</td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<UserDto> users = new();

    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        users = await Http.GetFromJsonAsync<List<UserDto>>(
            "api/admin/users") ?? new();

        isLoading = false;
    }
}
