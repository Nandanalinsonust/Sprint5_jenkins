@page "/appointments"
@attribute [Authorize]
@layout AdminLayout

@using HealthAxis.Shared.Dtos

@inject IAppointmentService AppointmentService
@inject IAuthService AuthService
@inject NavigationManager Nav

<h3 class="mb-4">Appointment Management</h3>

@if (isLoading)
{
    <LoadingSpinner Visible="true" />
}
else
{
    <!-- ✅ STATS -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="stat-card">
                <p>Total Appointments</p>
                <h3>@totalAppointments</h3>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-card">
                <p>Today</p>
                <h3>@todayAppointments</h3>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-card">
                <p>Upcoming</p>
                <h3>@upcomingAppointments</h3>
            </div>
        </div>
    </div>

    <!-- ✅ FILTER -->
    <div class="filter-bar">

        <input class="filter-input"
               placeholder="Search patient / doctor"
               value="@searchTerm"
               @oninput="OnSearchChanged" />

        <select class="filter-input" @bind="selectedStatus">
            <option value="">All</option>
            <option value="pending">Pending</option>
            <option value="confirmed">Confirmed</option>
            <option value="completed">Completed</option>
        </select>

        <button class="btn-clear" @onclick="ClearFilters">Clear</button>

    </div>

    <!-- ✅ TABLE -->
    <div class="table-container">
        <table class="table table-dark">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Patient</th>
                    <th>Doctor</th>
                    <th>Date</th>
                    <th>Time</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>
                @if (!filteredAppointments.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-white">
                            No appointments found
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var a in filteredAppointments)
                    {
                        <tr>
                            <td>#@a.AppointmentId</td>
                            <td>@a.PatientId</td>
                            <td>@a.DoctorId</td>
                            <td>@a.ScheduledDate.ToString("dd MMM yyyy")</td>
                            <td>@a.TimeSlot</td>

                            <td>
                                <span class="badge @GetStatusClass(a.Status)">
                                    @a.Status
                                </span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}
@code {
    private List<AppointmentDto> appointments = new();

    private bool isLoading = true;

    private string searchTerm = "";
    private string selectedStatus;

    private int totalAppointments;
    private int todayAppointments;
    private int upcomingAppointments;

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthService.IsAuthenticatedAsync())
        {
            Nav.NavigateTo("/login", true);
            return;
        }

        await LoadAppointments();
    }

    private async Task LoadAppointments()
    {
        try
        {
            isLoading = true;

            appointments = await AppointmentService.GetAllAsync();

            totalAppointments = appointments.Count;
            todayAppointments = appointments.Count(x => ParseDate(x.ScheduledDate.ToString("dd MMM yyyy")).Date == DateTime.Today);
            upcomingAppointments = appointments.Count(x => ParseDate(x.ScheduledDate.ToString("dd MMM yyyy")).Date > DateTime.Today);
        }
        finally
        {
            isLoading = false;
        }
    }

    private IEnumerable<AppointmentDto> filteredAppointments =>
    appointments.Where(a =>
        (string.IsNullOrWhiteSpace(searchTerm) ||

         a.PatientId.ToString().Contains(searchTerm) ||   
         a.DoctorId.ToString().Contains(searchTerm) ||    

         a.TimeSlot.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
    &&
        (string.IsNullOrEmpty(selectedStatus) ||
         a.Status.ToString().ToLower() == selectedStatus)
    );

    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        StateHasChanged();
    }

    private void ClearFilters()
    {
        searchTerm = "";
        selectedStatus = "";
    }

    private static DateTime ParseDate(string date)
    {
        return DateTime.TryParse(date, out var d) ? d : DateTime.MinValue;
    }

    private static string FormatDate(string date)
    {
        var d = ParseDate(date);
        return d == DateTime.MinValue ? "-" : d.ToString("dd MMM yyyy");
    }

    private static string GetStatusClass(object status)
    {
        return status.ToString().ToLower() switch
        {
            "pending" => "bg-warning",
            "confirmed" => "bg-info",
            "completed" => "bg-success",
            _ => "bg-secondary"
        };
    }
}