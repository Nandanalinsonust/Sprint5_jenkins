@page "/reports"
@attribute [Authorize]
@layout MainLayout

@inject HttpClient Http

<h3 class="mb-4">Appointment Reports</h3>

@if (isLoading)
{
    <p>Loading reports...</p>
}
else
{
    <!-- ✅ SUMMARY CARDS -->
    <div class="row mb-4">

        <div class="col-md-3">
            <div class="stat-card">
                <p>Pending</p>
                <h3>@totalPending</h3>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card">
                <p>Confirmed</p>
                <h3>@totalConfirmed</h3>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card">
                <p>Completed</p>
                <h3>@totalCompleted</h3>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card">
                <p>Cancelled</p>
                <h3>@totalCancelled</h3>
            </div>
        </div>

    </div>

    <!-- ✅ TABLE -->
    <div class="table-container">
        <table class="table table-dark">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Pending</th>
                    <th>Confirmed</th>
                    <th>Completed</th>
                    <th>Cancelled</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var r in reports)
                {
                    <tr>
                        <td>@r.Date.ToString("dd MMM yyyy")</td>
                        <td>@r.Pending</td>
                        <td>@r.Confirmed</td>
                        <td>@r.Completed</td>
                        <td>@r.Cancelled</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
@code {
    private List<AppointmentSummaryDto> reports = new();

    private bool isLoading = true;

    private int totalPending;
    private int totalConfirmed;
    private int totalCompleted;
    private int totalCancelled;

    protected override async Task OnInitializedAsync()
    {
        await LoadReports();
    }

    private async Task LoadReports()
    {
        try
        {
            reports = await Http.GetFromJsonAsync<List<AppointmentSummaryDto>>(
                "api/admin/reports/appointments") ?? new();

            CalculateTotals();
        }
        catch
        {
            reports = new();
        }

        isLoading = false;
    }

    private void CalculateTotals()
    {
        totalPending = reports.Sum(x => x.Pending);
        totalConfirmed = reports.Sum(x => x.Confirmed);
        totalCompleted = reports.Sum(x => x.Completed);
        totalCancelled = reports.Sum(x => x.Cancelled);
    }
}