{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DbCon": "Server=.;Database=HealthAxis_db;User Id=nandana;Password=1234;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "HealthAxis.Api",
    "Audience": "HealthAxis.Api",
    "Key": "5f2de4332843ba64011d04703b5f955e6c07ddb8e5a45e66d0e5c01af2989a4b",
    "AccessTokenExpirationMinutes": 15
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "HealthAxisQueue": "HealthAxis.Api.events.queue"
  },
  "Garnet": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "HealthAxis:"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Elastic.Serilog.Sinks" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/healthaxis-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      },
      {
        "Name": "Elasticsearch",
        "Args": {
          "nodes": [ "http://localhost:9200" ],
          "dataStream": "logs-healthaxis-training",
          "bootstrapMethod": "Failure"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentName" ],
    "Properties": {
      "Application": "HealthAxis.Api"
    }
  }
}